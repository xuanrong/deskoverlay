{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskOverlay",
  "version": "0.3.0",
  "identifier": "com.deskoverlay.app",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node ../frontend/serve.js",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeskOverlay",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "transparent": false,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": false
      },
      {
        "label": "reminder",
        "title": "提醒",
        "url": "reminder.html",
        "width": 380,
        "height": 150,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
